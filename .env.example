# ==============================================================================
# SSLGuard - Environment Variables Template
# Copy this file to .env and configure with your specific values.
# NEVER commit your actual .env file or production secret keys to version control!
# ==============================================================================

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sslchecker
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Secret Key (Must be at least 256 bits / 32+ characters for HS512)
JWT_SECRET=replace-with-a-secure-random-256-bit-jwt-secret-key-for-production-environment

# SMTP Mail Alert Configuration (Optional - for expiration notifications)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# Server Ports
SERVER_PORT=8080
VITE_PORT=5173
