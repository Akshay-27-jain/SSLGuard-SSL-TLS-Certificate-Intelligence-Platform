# ==========================================
# SSLGuard - Root .gitignore
# ==========================================

# Secrets & Environment Variables (NEVER commit secrets!)
.env
.env.*
!.env.example
*.env
*.secret
*.secrets
credentials.json
service-account*.json
secrets.properties
application-local.properties
application-secret.properties
application-prod.properties

# Cryptographic Keys & Certificates
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.crt
*.cer

# Backend / Java / Maven
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Frontend / Node / Vite
node_modules/
dist/
dist-ssr/
*.local
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Configurations
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs & Temporary Files
logs/
*.log
temp/
tmp/

# Build & CI temporary artifacts
.github/modernize/
.gemini/
